# Copy to .env before deployment. Compose reads this automatically.
QWEN_IMAGE=open-llm-qwen3:1.0
QWEN_PLATFORM=linux/amd64
BUILD_JOBS=6
QWEN_BIND_IP=127.0.0.1
QWEN_PORT=8082
QWEN_THREADS=6
QWEN_THREADS_BATCH=6
QWEN_CTX_SIZE=4096
QWEN_PARALLEL=1
# Optional bearer token. Keep .env private if populated.
QWEN_API_KEY=
